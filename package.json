{
  "name": "pdf2pix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private browser-local PDF to image conversion",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/licenses.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:assets && npm run check:docs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "lucide-react": "^1.53.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LakshmiNarayanan2003/pdf-to-image.git"
  },
  "homepage": "https://lakshminarayanan2003.github.io/pdf-to-image/"
}
